{
  "manifest_version": 3,
  "name": "Sophia: Image & Video to Prompt",
  "version": "0.2.0",
  "description": "Convert images & videos into prompts with freely configurable models",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/loader.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/sophia-app.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Sophia: Image & Video to Prompt"
  },
  "icons": {
    "16": "icons/newlogo.png",
    "48": "icons/newlogo.png",
    "128": "icons/newlogo.png"
  }
}
